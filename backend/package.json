{
  "name": "@ai-mod/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/server.ts",
    "dev:varlock": "varlock run --path ../.env.schema -- tsx watch src/server.ts",
    "start": "node dist/server.js",
    "start:varlock": "varlock run --path ../.env.schema -- node dist/server.js",
    "test": "vitest run",
    "test:varlock": "varlock run --path ../.env.schema -- vitest run",
    "test:coverage": "vitest run --coverage",
    "test:coverage:varlock": "varlock run --path ../.env.schema -- vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "express": "^5.1.0",
    "mongoose": "^8.16.5",
    "raison": "^0.2.2",
    "unified-creator-metrics": "^0.3.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.15",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^3.2.4",
    "memgoose": "^2.3.0",
    "supertest": "^7.1.3",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
