NODE_ENV=production
PORT=3000

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-nano

RAISON_API_KEY=
RAISON_QNA_PROMPT_ID=6a10c0f77a74ff59899f61e5
RAISON_NORMALIZE_PROMPT_ID=6a1775683bed3b22a56548d7
RAISON_BAN_PROMPT_ID=6a1776613bed3b22a5654afc
RAISON_TIMEOUT_PROMPT_ID=6a1773313bed3b22a56545ec

YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_CLIENT_ID_1=
YOUTUBE_CLIENT_SECRET_1=

# Same-origin Render deployment:
#   GOOGLE_REDIRECT_URI=https://your-frontend-domain/api/auth/google/callback
# Vercel frontend with /api rewrite to Render backend:
#   GOOGLE_REDIRECT_URI=https://your-vercel-domain/api/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback
FRONTEND_APP_URL=http://localhost:8080

# Only needed when the browser calls the backend directly from another origin.
CORS_ALLOWED_ORIGINS=
SESSION_SECRET=
SESSION_COOKIE_SAME_SITE=lax
AUTH_TOKEN_ENCRYPTION_KEY=

YOUTUBE_API_KEY=
YOUTUBE_API_KEY_1=
YOUTUBE_TIMEOUT_DURATION_SECONDS=300
STREAM_OVERVIEW_CACHE_TTL_MS=60000

# docker-compose overrides this to use the local mongo service.
MONGODB_URI=mongodb://mongo:27017/ai-mod
MONGODB_HOSTPORT=
MONGODB_DATABASE=ai-mod
