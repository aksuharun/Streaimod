# @plugin(@varlock/keepass-plugin)
# @currentEnv=$APP_ENV
# @initKeePass(dbPath="/Users/aksuharun/Secrets/dev-secrets.kdbx", password=$KP_PASSWORD, useCli=forEnv(dev))
# @defaultSensitive=true
# ---

APP_ENV=dev
PORT=3000

# @type=kdbxPassword @sensitive
KP_PASSWORD=

# @required @sensitive @type=string
OPENAI_API_KEY=kp("OPENAI_API_KEY")

OPENAI_MODEL=gpt-5.4-nano

# @required @sensitive @type=string
RAISON_API_KEY=kp("RAISON_API_KEY")

# @required @type=string
RAISON_QNA_PROMPT_ID=6a10c0f77a74ff59899f61e5

# @required @type=string
RAISON_NORMALIZE_PROMPT_ID=6a1775683bed3b22a56548d7

# @required @type=string
RAISON_BAN_PROMPT_ID=6a1776613bed3b22a5654afc

# @required @type=string
RAISON_TIMEOUT_PROMPT_ID=6a1773313bed3b22a56545ec

# @optional @sensitive @type=string
YOUTUBE_CLIENT_ID=kp("YOUTUBE_CLIENT_ID")

# @optional @sensitive @type=string
YOUTUBE_CLIENT_SECRET=kp("YOUTUBE_CLIENT_SECRET")

# @optional @sensitive @type=string
YOUTUBE_CLIENT_ID_1=kp("YOUTUBE_CLIENT_ID_1")

# @optional @sensitive @type=string
YOUTUBE_CLIENT_SECRET_1=kp("YOUTUBE_CLIENT_SECRET_1")

# @required @type=string
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback

# @optional @type=string
FRONTEND_APP_URL=http://localhost:5173

# @optional @type=string
# Comma-separated allowlist for credentialed frontend requests. When empty in
# local development, localhost and 127.0.0.1 origins are allowed automatically.
CORS_ALLOWED_ORIGINS=

# @required @sensitive @type=string
SESSION_SECRET=kp("SESSION_SECRET")

# @required @sensitive @type=string
AUTH_TOKEN_ENCRYPTION_KEY=kp("AUTH_TOKEN_ENCRYPTION_KEY")

# @optional @sensitive @type=string
# Optional YouTube Data API keys for read-only lookups. `YOUTUBE_API_KEY` is
# tried first, then suffixed spares like `YOUTUBE_API_KEY_1`.
YOUTUBE_API_KEY=kp("YOUTUBE_API_KEY")

# @optional @sensitive @type=string
YOUTUBE_API_KEY_1=kp("YOUTUBE_API_KEY_1")

# @optional @type=string
YOUTUBE_TIMEOUT_DURATION_SECONDS=300

# @optional @type=string
# Cache window for dashboard YouTube stream lookups. Manual Sync Data bypasses this.
STREAM_OVERVIEW_CACHE_TTL_MS=60000

# @required @type=string
MONGODB_URI=mongodb://localhost:27017/ai-mod
